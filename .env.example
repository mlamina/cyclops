# Required
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown)
# CYCLOPS_MODEL=gpt-realtime-2.1        # or gpt-realtime-2.1-mini (cheaper, less reliable tool calls)
# CYCLOPS_REASONING_EFFORT=low          # minimal|low|medium|high|xhigh (2.x models)
# CYCLOPS_VOICE=marin
# CYCLOPS_VOLUME=100                    # output volume percent 0-100 (also a slider in the touchscreen UI)
# CYCLOPS_CAMERA_INDEX=auto            # auto|0|1|... (auto probes and remembers)
# CYCLOPS_HALF_DUPLEX=auto             # auto|1|0 — speaker mode when output is a speaker
# CYCLOPS_BARGE_IN_DB=8                 # dB over the echo to interrupt in speaker mode (or "off")
# CYCLOPS_LANG=en                       # ISO-639-1 transcription hint, or "auto" to detect
# CYCLOPS_SESSIONS_DIR=sessions         # one folder per session: transcript, photos, video
# CYCLOPS_CAPTURES_DIR=captures         # where a photo goes when no session is running
# CYCLOPS_PROJECTS_DIR=projects         # one folder per project: README, Log, Photos
# CYCLOPS_SLUG=1                        # name each finished session from its transcript
# CYCLOPS_PROJECTS=1                    # keep projects/ up to date and offer the project tools
# CYCLOPS_PROJECT_PHOTOS=3              # hero shots copied into a project per session (0 = none)
# CYCLOPS_RECORD=1                      # record the camera into the session folder (0 disables)
# CYCLOPS_RECORD_FPS=15                 # video sampling rate of the recording
# CYCLOPS_RECORD_WIDTH=640              # recording is fit to this width, never upscaled
# CYCLOPS_ADMIN_HOST=0.0.0.0            # 127.0.0.1 keeps the admin page off the LAN
# CYCLOPS_ADMIN_PORT=80                 # the kiosk's gear button opens this same port
